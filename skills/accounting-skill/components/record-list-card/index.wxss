.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin: 8px 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #1D1D1F;
}

.card-subtitle {
  font-size: 12px;
  color: #8E8E93;
  margin-top: 2px;
}

.count-text {
  font-size: 12px;
  color: #8E8E93;
}

.summary-row {
  display: flex;
  align-items: center;
  background: #F7F7F8;
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 12px;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-divider {
  width: 1px;
  height: 28px;
  background: #E5E5EA;
}

.summary-label {
  font-size: 12px;
  color: #8E8E93;
  margin-bottom: 4px;
}

.summary-amount {
  font-size: 16px;
  font-weight: 600;
}

.expense {
  color: #F04438;
}

.income {
  color: #12B76A;
}

.record-list {
  max-height: 320px;
  overflow-y: auto;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #F0F0F0;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
}

.record-category-tag {
  display: inline-block;
  background: #F5F5F7;
  color: #6E6E73;
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 8px;
  flex-shrink: 0;
}

.record-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.record-note {
  font-size: 14px;
  color: #1D1D1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-date {
  font-size: 11px;
  color: #8E8E93;
  margin-top: 2px;
}

.record-right {
  flex-shrink: 0;
  margin-left: 8px;
}

.record-amount {
  font-size: 14px;
  font-weight: 500;
}

.empty-state {
  padding: 24px 0;
  text-align: center;
}

.empty-text {
  font-size: 14px;
  color: #8E8E93;
}

.card-footer {
  display: flex;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid #F0F0F0;
  margin-top: 4px;
}

.btn {
  flex: 1;
  height: 40px;
  line-height: 40px;
  text-align: center;
  font-size: 14px;
  font-weight: 500;
  border-radius: 999px;
}

.btn-primary {
  background: #2C2C2E;
  color: #FFFFFF;
}

.btn-secondary {
  background: #F2F2F7;
  color: #1D1D1F;
}

/* 暗黑模式 */
@media (prefers-color-scheme: dark) {
  .card {
    background: #1C1C1E;
  }

  .card-title, .record-note {
    color: #FFFFFF;
  }

  .card-subtitle, .count-text, .summary-label, .record-date, .empty-text {
    color: rgba(255, 255, 255, 0.5);
  }

  .summary-row {
    background: #2C2C2E;
  }

  .summary-divider {
    background: rgba(255, 255, 255, 0.08);
  }

  .record-item {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .record-category-tag {
    background: #2C2C2E;
    color: rgba(255, 255, 255, 0.68);
  }

  .btn-primary {
    background: #FFFFFF;
    color: #1C1C1E;
  }

  .btn-secondary {
    background: #2C2C2E;
    color: #FFFFFF;
  }

  .card-footer {
    border-top-color: rgba(255, 255, 255, 0.08);
  }
}
