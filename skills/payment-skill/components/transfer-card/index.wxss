.tf-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8E1 100%);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(245, 124, 0, 0.08);
  box-sizing: border-box;
  width: 100%;
}

.tf-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.tf-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tf-icon {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.tf-header-text {
  flex: 1;
}

.tf-state {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.tf-amount {
  font-size: 44rpx;
  font-weight: 800;
  color: #E65100;
  margin-top: 4rpx;
}

.tf-info {
  padding: 18rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.tf-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.tf-label {
  font-size: 24rpx;
  color: #8898AA;
  flex-shrink: 0;
}

.tf-value {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-mono {
  font-family: monospace;
  font-size: 20rpx;
}

.tf-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.tf-btn {
  padding: 14rpx 40rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  background: #FFF3E0;
  color: #E65100;
}

.tf-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #2E7D32;
  text-align: center;
  letter-spacing: 1rpx;
}

.tf-tip-warn {
  color: #7B1FA2;
}

/* ========== 暗黑模式 ========== */
@media (prefers-color-scheme: dark) {
  .tf-card {
    background: linear-gradient(180deg, #1E1E1E 0%, #1A1500 100%);
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  }
  .tf-state {
    color: #E8E8E8;
  }
  .tf-amount {
    color: #FFB74D;
  }
  .tf-info {
    background: #2A2A2A;
  }
  .tf-label {
    color: #6E7A8A;
  }
  .tf-value {
    color: #E8E8E8;
  }
  .tf-btn {
    background: #2A1A00;
    color: #FFB74D;
  }
  .tf-tip {
    color: #66BB6A;
  }
  .tf-tip-warn {
    color: #CE93D8;
  }
}
