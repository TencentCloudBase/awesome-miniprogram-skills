.rf-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  width: 100%;
}

.rf-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.rf-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rf-icon {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.rf-header-text {
  flex: 1;
}

.rf-state {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.rf-amount {
  font-size: 44rpx;
  font-weight: 800;
  color: #2E7D32;
  margin-top: 4rpx;
}

.rf-info {
  padding: 18rpx 20rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
}

.rf-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.rf-label {
  font-size: 24rpx;
  color: #8898AA;
  flex-shrink: 0;
}

.rf-value {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rf-mono {
  font-family: monospace;
  font-size: 20rpx;
}

.rf-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.rf-btn {
  padding: 14rpx 40rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  background: #E3F2FD;
  color: #1565C0;
}

.rf-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #2E7D32;
  text-align: center;
  letter-spacing: 1rpx;
}

/* ========== 暗黑模式 ========== */
@media (prefers-color-scheme: dark) {
  .rf-card {
    background: #1E1E1E;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  }
  .rf-state {
    color: #E8E8E8;
  }
  .rf-amount {
    color: #66BB6A;
  }
  .rf-info {
    background: #2A2A2A;
  }
  .rf-label {
    color: #6E7A8A;
  }
  .rf-value {
    color: #E8E8E8;
  }
  .rf-btn {
    background: #1A2A3A;
    color: #64B5F6;
  }
  .rf-tip {
    color: #66BB6A;
  }
}
