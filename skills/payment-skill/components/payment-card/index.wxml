<view class="pay-card">
  <view class="pay-badge" style="background: {{statusColor}};">
    <view class="pay-icon">{{statusIcon}}</view>
  </view>
  <view class="pay-title">{{statusText}}</view>
  <view class="pay-amount">¥{{totalFeeYuan}}</view>

  <view class="pay-info">
    <view wx:if="{{description}}" class="pay-row">
      <text class="pay-label">商品</text>
      <text class="pay-value">{{description}}</text>
    </view>
    <view class="pay-row">
      <text class="pay-label">订单号</text>
      <text class="pay-value pay-mono">{{outTradeNo}}</text>
    </view>
    <view wx:if="{{payTimeText}}" class="pay-row">
      <text class="pay-label">支付时间</text>
      <text class="pay-value">{{payTimeText}}</text>
    </view>
  </view>

  <view wx:if="{{status === 'SUCCESS'}}" class="pay-actions">
    <view class="pay-btn pay-btn-secondary" bind:tap="onTapQueryOrder">查看详情</view>
  </view>
</view>
