.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin: 8px 0;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.card-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin-right: 10px;
  background: #F0F5FF;
}

.icon-delete {
  background: #FFF1F0;
}

.card-title-wrap {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 16px;
  font-weight: 500;
  color: #1D1D1F;
}

.card-subtitle {
  font-size: 12px;
  color: #8E8E93;
  margin-top: 2px;
}

.card-content {
  padding: 8px 0;
}

.event-title {
  font-size: 18px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12px;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10px;
}

.info-icon {
  font-size: 16px;
  margin-right: 8px;
  margin-top: 2px;
  flex-shrink: 0;
}

.info-text {
  display: flex;
  flex-direction: column;
}

.info-main {
  font-size: 14px;
  color: #1D1D1F;
}

.info-sub {
  font-size: 12px;
  color: #8E8E93;
  margin-top: 2px;
}

.subscribe-tag {
  color: #1677FF;
}

.deleted-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.deleted-title {
  font-size: 15px;
  color: #1D1D1F;
  text-decoration: line-through;
  opacity: 0.6;
}

.deleted-detail {
  font-size: 12px;
  color: #8E8E93;
}

.card-footer {
  display: flex;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid #F0F0F0;
  margin-top: 4px;
}

.btn {
  flex: 1;
  height: 40px;
  line-height: 40px;
  text-align: center;
  font-size: 14px;
  font-weight: 500;
  border-radius: 999px;
}

.btn-primary {
  background: #1677FF;
  color: #FFFFFF;
}

.btn-secondary {
  background: #F2F2F7;
  color: #1D1D1F;
}

/* 暗黑模式 */
@media (prefers-color-scheme: dark) {
  .card {
    background: #1C1C1E;
  }

  .card-title, .event-title, .info-main {
    color: #FFFFFF;
  }

  .card-subtitle, .info-sub, .deleted-detail {
    color: rgba(255, 255, 255, 0.5);
  }

  .card-icon {
    background: #2C2C2E;
  }

  .icon-delete {
    background: #3A2020;
  }

  .deleted-title {
    color: #FFFFFF;
  }

  .card-footer {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .btn-primary {
    background: #1677FF;
    color: #FFFFFF;
  }

  .btn-secondary {
    background: #2C2C2E;
    color: #FFFFFF;
  }
}
